{
  "name": "bubble-file-manager",
  "version": "0.1.0",
  "description": "A bubble-themed, Pinterest-style file manager built with Electron for our HCI hackathon project.",
  "main": "./out/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "start": "bun run build && electron .",
    "dev": "electron-vite dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hackathon.bubblefilemanager",
    "productName": "Bubble File Manager",
    "files": [
      "out/**/*",
      "template-assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
